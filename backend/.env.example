# ==========================================
# CRAVECACHE BACKEND ENVIRONMENT VARIABLES (Render)
# ==========================================
PORT=3000
NODE_ENV=production

# Database & Auth
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/cravecache?retryWrites=true&w=majority
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRE=7d
COOKIE_EXPIRE=7

# Stripe Payments
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# Cloudinary Media
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Gemini AI & Frontend CORS
GEMINI_API_KEY=your_gemini_api_key_here
FRONTEND_URL=https://cravecache.vercel.app
