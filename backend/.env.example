# ==========================================================================
# CRAVECACHE BACKEND ENVIRONMENT VARIABLES (split-deployment variant)
#
# Only needed if you deploy backend/ as a standalone API service. For the
# normal single-service setup use the root .env instead — see DEPLOYMENT.md.
# ==========================================================================
PORT=5000
NODE_ENV=production

# --- DATABASE (MongoDB / Atlas) ---
# Real persistence. Without this the API uses an in-memory store that resets on
# every restart. Include the database name (/cravecache) BEFORE the "?" — the
# string Atlas gives you omits it, which silently uses a database named "test".
# URL-encode the password if it contains any of  @ : / ? # [ ] %
# Empty collections are seeded on first connect. Verify at GET /api/health.
MONGODB_URI=mongodb+srv://user:password@cluster.xxxxx.mongodb.net/cravecache?retryWrites=true&w=majority

# --- AI (Google Gemini) ---
GEMINI_API_KEY=your_gemini_api_key_here

# --- AUTHENTICATION (Clerk: Google / GitHub / Microsoft) ---
# Verifies session tokens posted to /api/auth/clerk. SECRET — never commit.
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key

# --- ROLE ASSIGNMENT ---
# Server-authoritative: the email on the verified Clerk account is matched
# against these lists; anyone unlisted becomes a 'customer'. A client cannot
# request a role. Comma-separated, case-insensitive.
ADMIN_EMAILS=
OWNER_EMAILS=

# Passwordless demo login. Set to false for any public deployment.
ALLOW_DEMO_LOGIN=true

# --- CORS ---
# Browser origins allowed to call this API. Required for the split deployment,
# otherwise the browser blocks the response. Comma-separated, no trailing slash.
# If BOTH of these are unset, any origin is allowed (fine for local dev only).
ALLOWED_ORIGINS=https://cravecache.vercel.app,http://localhost:3000

# Single-value alias, accepted for backwards compatibility.
FRONTEND_URL=https://cravecache.vercel.app

# ==========================================================================
# STRIPE PAYMENTS  —  FILL THESE IN
# Dashboard > Developers > API keys. Until set, payments stay simulated.
# ==========================================================================
STRIPE_SECRET_KEY=
STRIPE_CURRENCY=inr

# How payments behave:
#   auto      (default) real Stripe when STRIPE_SECRET_KEY is set, else simulated
#   simulate  built-in demo checkout — works with NO Stripe account at all
#   stripe    require real Stripe; never silently fall back
PAYMENT_MODE=auto

# ==========================================================================
# CLOUDINARY IMAGE STORAGE  —  FILL THESE IN
# All three appear on the Cloudinary dashboard home. Until all three are set,
# uploads fall back to inline base64 and are not persisted.
# ==========================================================================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ==========================================================================
# NOT IMPLEMENTED YET — no code reads this.
#   JWT_SECRET          demo tokens are simulated; Clerk handles real sessions
#   STRIPE_WEBHOOK_SECRET   no webhook endpoint exists yet
# ==========================================================================
