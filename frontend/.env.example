# ==========================================================================
# CRAVECACHE FRONTEND ENVIRONMENT VARIABLES (split deployment / Vercel)
#
# Only needed when the client is hosted separately from the API. For the
# single-service setup use the root .env instead — see DEPLOYMENT.md.
#
# VITE_ variables are inlined at BUILD time, so changing one requires a
# rebuild, not just a restart.
# ==========================================================================

# Origin of the API service. Every request is prefixed with this.
# Leave EMPTY for single-service mode, where '/api/...' is same-origin.
# No trailing slash.
VITE_API_URL=https://cravecache-backend.onrender.com

# Clerk social sign-in (Google / GitHub / Microsoft).
# Publishable key only — CLERK_SECRET_KEY must never reach the browser.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key

# ==========================================================================
# NOT IMPLEMENTED YET — no code reads this. Payments are simulated.
#   VITE_STRIPE_PUBLISHABLE_KEY
# ==========================================================================

# Stripe publishable key. Safe to expose; the secret key stays on the server.
# Until this is set, card checkout renders in simulated mode.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
