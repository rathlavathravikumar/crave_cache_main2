# ==========================================================================
# CRAVECACHE ENVIRONMENT VARIABLES
#
# Copy to .env and fill in what you need:  cp .env.example .env
#
# The app runs with NONE of these set — social sign-in shows a setup hint and
# the AI endpoints fall back to non-AI ranking. Nothing breaks.
#
# Everything below is read by the code. Variables for services that are not
# wired up yet are listed at the bottom, clearly marked.
# ==========================================================================

# --- RUNTIME ---
# PORT is provided by most hosts; the server falls back to 3000.
PORT=3000
NODE_ENV=development


# --- DATABASE (MongoDB / Atlas) ---------------------------------------------
# Real persistence. Without this the app uses an in-memory store and all data
# resets on restart. Free M0 Atlas cluster is plenty for this dataset.
#
# Remember to include the database name (/cravecache) BEFORE the "?" — the
# string Atlas hands you omits it, which silently uses a database named "test".
# URL-encode the password if it contains any of  @ : / ? # [ ] %
#
# Empty collections are seeded from src/data/initialData.ts on first connect.
# Confirm which store is live at GET /api/health.
MONGODB_URI=mongodb+srv://user:password@cluster.xxxxx.mongodb.net/cravecache?retryWrites=true&w=majority


# --- STRIPE PAYMENTS --------------------------------------------------------
# Dashboard > Developers > API keys. Use TEST keys while developing.
# Until both keys are set, card checkout runs in simulated mode.
# Card details are entered in Stripe's own iframe and never reach this server.
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# Currency for new charges; must be enabled on your Stripe account.
STRIPE_CURRENCY=inr

# How payments behave:
#   auto      (default) real Stripe when STRIPE_SECRET_KEY is set, else simulated
#   simulate  built-in demo checkout — works with NO Stripe account at all
#   stripe    require real Stripe; never silently fall back
PAYMENT_MODE=auto


# --- CLOUDINARY IMAGE STORAGE -----------------------------------------------
# All three are on the Cloudinary dashboard home. Until all three are set,
# uploads fall back to inline base64 and are not persisted to a CDN.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret


# --- AI (Google Gemini) -----------------------------------------------------
# Powers /api/ai/assistant and /api/recommendations. Server-side only — this
# key is never sent to the browser.
GEMINI_API_KEY=your_gemini_api_key_here


# --- AUTHENTICATION (Clerk: Google / GitHub / Microsoft) --------------------
# Both keys come from Clerk Dashboard > API Keys.

# Frontend key. Safe to expose. MUST keep the VITE_ prefix or Vite will not
# expose it to the client. Inlined at build time — changing it needs a rebuild.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key

# Backend key, used to verify session tokens. SECRET — never commit a real one.
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key


# --- ROLE ASSIGNMENT --------------------------------------------------------
# Roles are server-authoritative: the email on the verified Clerk account is
# matched against these lists, and anyone unlisted becomes a 'customer'.
# A client cannot request a role. Comma-separated, case-insensitive.
ADMIN_EMAILS=
OWNER_EMAILS=

# Passwordless demo login (seeded accounts, any password accepted).
# Set to false for any public deployment.
ALLOW_DEMO_LOGIN=true


# --- CORS (split deployment only) -------------------------------------------
# Not needed for the single-service setup: the client and API share an origin,
# so no preflight happens. Set this only when hosting the client separately.
# Comma-separated, no trailing slash. Unset = any origin (local dev only).
# ALLOWED_ORIGINS=https://your-frontend.vercel.app

# Origin of the API, for a separately hosted client. Empty = same origin.
# Inlined at BUILD time, so changing it needs a rebuild.
# VITE_API_URL=


# ==========================================================================
# NOT IMPLEMENTED YET
#
# Setting these has no effect — no code reads them. They are kept as a record
# of the intended integrations. See "Current limitations" in README.md.
#
#   JWT_SECRET           demo tokens are simulated; Clerk handles real sessions
#   STRIPE_WEBHOOK_SECRET   no webhook endpoint exists yet
#
# Only needed for the split frontend/ + backend/ deployment variant:
#   VITE_API_URL         backend origin for the Vercel frontend
#   FRONTEND_URL         allowed CORS origin for the standalone backend
# ==========================================================================
