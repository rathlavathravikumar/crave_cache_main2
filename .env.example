# ==========================================
# CRAVECACHE PRODUCTION ENVIRONMENT VARIABLES
# ==========================================

# --- FRONTEND (Vite / Vercel) ---
VITE_API_URL=https://cravecache-api.onrender.com
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# --- BACKEND (Node.js / Express / Render) ---
PORT=3000
NODE_ENV=production

# --- DATABASE & AUTH ---
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/cravecache?retryWrites=true&w=majority
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
JWT_EXPIRE=7d
COOKIE_EXPIRE=7

# --- PAYMENT GATEWAY (Stripe) ---
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# --- MEDIA UPLOAD (Cloudinary) ---
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# --- AI & RUNTIME ---
GEMINI_API_KEY=your_gemini_api_key_here
FRONTEND_URL=https://cravecache.vercel.app
APP_URL=https://cravecache.vercel.app
